<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nofarma.Desktop.Views.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sales="using:Nofarma.Application.Sales"
    xmlns:viewModels="using:Nofarma.Desktop.ViewModels"
    Background="{StaticResource NofarmaCanvasBrush}"
    Loaded="OnLoaded">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F2" Invoked="OnSearchAccelerator" />
        <KeyboardAccelerator Key="F4" Invoked="OnSuspendAccelerator" />
        <KeyboardAccelerator Key="F6" Invoked="OnSuspendedSalesAccelerator" />
        <KeyboardAccelerator Key="F8" Invoked="OnPaymentAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Padding="16,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource NofarmaHeadingStyle}" Text="Vendas" />
                <TextBlock
                    Foreground="{StaticResource NofarmaMutedBrush}"
                    Text="Ponto de venda local. Pesquisa, carrinho e pagamento continuam disponíveis sem internet." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button
                    MinHeight="44"
                    AutomationProperties.Name="Abrir vendas suspensas, atalho F6"
                    Click="OnOpenSuspendedSales"
                    Content="Suspensas   F6" />
                <Button
                    MinHeight="44"
                    AutomationProperties.Name="Suspender venda actual, atalho F4"
                    Click="OnOpenSuspend"
                    Content="Suspender   F4" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="SalesMessage"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CartColumn" Width="440" />
            </Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SalesWidthStates">
                    <VisualState x:Name="CompactSalesLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CartColumn.Width" Value="400" />
                            <Setter Target="ProductDetailPanel.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="ApprovedSalesLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1366" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CartColumn.Width" Value="460" />
                            <Setter Target="ProductDetailPanel.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="10"
                    Background="White"
                    BorderBrush="{StaticResource NofarmaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="ProductSearchBox"
                            MinHeight="44"
                            AutomationProperties.Name="Pesquisar produto por código de barras, código ou nome"
                            PlaceholderText="Digite o código de barras, código ou nome do produto"
                            QueryIcon="Find"
                            QuerySubmitted="OnSearchSubmitted" />
                        <Button
                            Grid.Column="1"
                            MinWidth="116"
                            MinHeight="44"
                            AutomationProperties.Name="Pesquisar produto, atalho F2"
                            Click="OnSearchClick"
                            Content="Pesquisar   F2" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Background="White"
                    BorderBrush="{StaticResource NofarmaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <ListView
                            x:Name="SearchResultsList"
                            AutomationProperties.Name="Resultados da pesquisa de produtos"
                            IsItemClickEnabled="True"
                            ItemClick="OnProductClicked"
                            SelectionMode="Single">
                            <ListView.Header>
                                <Grid MinHeight="40" Padding="12,0" Background="#EEF3F9" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Código" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Produto" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Embalagem" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="Stock" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="Preço (XOF)" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="sales:SaleProductResult">
                                    <Grid MinHeight="46" Padding="12,5" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Code}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind PackageName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind AvailableQuantityBase}" />
                                        <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind SalePriceXof}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            x:Name="SearchEmptyState"
                            MaxWidth="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource NofarmaBlueBrush}" Glyph="&#xE721;" />
                            <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Pesquisa um produto para começar" />
                            <TextBlock
                                Foreground="{StaticResource NofarmaMutedBrush}"
                                Text="Sem resultados. Confirma o código ou pesquisa pelo nome do produto."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ProgressRing x:Name="SearchProgress" Width="34" Height="34" IsActive="False" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Border
                    x:Name="ProductDetailPanel"
                    Grid.Row="2"
                    MinHeight="74"
                    Padding="12"
                    Background="White"
                    BorderBrush="{StaticResource NofarmaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="SelectedProductName" FontWeight="SemiBold" Text="Selecciona um produto" />
                            <TextBlock x:Name="SelectedProductCode" Foreground="{StaticResource NofarmaMutedBrush}" Text="O detalhe do lote FEFO aparece aqui." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="SelectedProductStock" Text="Stock vendável: indisponível" />
                            <TextBlock x:Name="SelectedProductLot" Foreground="{StaticResource NofarmaMutedBrush}" Text="Primeiro lote: indisponível" />
                        </StackPanel>
                        <Button
                            x:Name="AddSelectedProductButton"
                            Grid.Column="2"
                            MinHeight="44"
                            AutomationProperties.Name="Adicionar produto seleccionado ao carrinho"
                            Click="OnAddSelectedProduct"
                            Content="Adicionar"
                            IsEnabled="False"
                            Style="{StaticResource NofarmaPrimaryButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Background="White"
                BorderBrush="{StaticResource NofarmaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                AutomationProperties.Name="Carrinho da venda">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="14,10" Background="{StaticResource NofarmaBlueDarkBrush}" CornerRadius="8,8,0,0">
                        <Grid>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="White" Text="CARRINHO DA VENDA" />
                            <TextBlock x:Name="CartCountText" HorizontalAlignment="Right" Foreground="#D7E8F8" Text="0 linhas" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListView x:Name="CartList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:SaleCartLineViewModel">
                                    <Border Margin="8,4" Padding="10" Background="#F8FAFD" CornerRadius="6">
                                        <Grid RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12" Foreground="{StaticResource NofarmaMutedBrush}" Text="{x:Bind PackageName}" />
                                                </StackPanel>
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    MinWidth="40"
                                                    MinHeight="40"
                                                    Click="OnRemoveCartLine"
                                                    Loaded="OnCartLineControlLoaded"
                                                    Tag="Remover">
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                </Grid.ColumnDefinitions>
                                                <Button MinWidth="40" MinHeight="40" Click="OnDecreaseQuantity" Loaded="OnCartLineControlLoaded" Tag="Diminuir">
                                                    <FontIcon Glyph="&#xE738;" />
                                                </Button>
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind QuantityPackages}" />
                                                <Button Grid.Column="2" MinWidth="40" MinHeight="40" Click="OnIncreaseQuantity" Loaded="OnCartLineControlLoaded" Tag="Aumentar">
                                                    <FontIcon Glyph="&#xE710;" />
                                                </Button>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource NofarmaMutedBrush}" Text="Desconto" />
                                                <TextBox
                                                    Grid.Column="4"
                                                    MinHeight="40"
                                                    AutomationProperties.Name="Desconto da linha em XOF"
                                                    InputScope="Number"
                                                    Loaded="OnCartLineControlLoaded"
                                                    LostFocus="OnLineDiscountLostFocus"
                                                    Tag="Definir desconto para"
                                                    Text="{x:Bind DiscountXof}" />
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <TextBlock x:Name="ReviewText" Foreground="{StaticResource NofarmaWarningBrush}" Text="{x:Bind ReviewMessage}" TextWrapping="Wrap" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NofarmaBlueBrush}" Text="{x:Bind TotalXof}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            x:Name="CartEmptyState"
                            MaxWidth="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource NofarmaBlueBrush}" Glyph="&#xE7BF;" />
                            <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="Ainda não existem produtos no carrinho" />
                            <TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="Pesquisa um produto e adiciona-o. O stock só muda quando concluíres a venda." TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Padding="14" BorderBrush="{StaticResource NofarmaBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="9">
                            <Grid>
                                <TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="Subtotal" />
                                <TextBlock x:Name="SubtotalText" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid>
                                <TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="Desconto" />
                                <TextBox x:Name="TotalDiscountBox" Width="110" MinHeight="40" HorizontalAlignment="Right" InputScope="Number" LostFocus="OnTotalDiscountLostFocus" Text="0" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="TOTAL" />
                                <TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NofarmaBlueBrush}" />
                            </Grid>
                            <Button
                                x:Name="CompleteSaleButton"
                                MinHeight="52"
                                AutomationProperties.Name="Abrir pagamento da venda, atalho F8"
                                Click="OnOpenPayment"
                                Content="Pagamento   F8"
                                Style="{StaticResource NofarmaPrimaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="10,7" Background="#FFF4D6" BorderBrush="#E8C35A" BorderThickness="1" CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Foreground="#7A5200" Glyph="&#xE701;" />
                <TextBlock Foreground="#5E4200" Text="Sem internet. A venda será guardada localmente e sincronizada quando a ligação estiver disponível." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid x:Name="PanelScrim" Grid.RowSpan="4" Background="#660B1728" Visibility="Collapsed">
            <Border
                x:Name="PaymentPanel"
                Width="460"
                Padding="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="White"
                Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Pagamento" />
                            <Button HorizontalAlignment="Right" MinWidth="44" MinHeight="44" AutomationProperties.Name="Fechar pagamento" Click="OnClosePanel" Content="Fechar" />
                        </Grid>
                        <TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="Regista um ou mais métodos. O troco só pode sair do valor recebido em dinheiro." TextWrapping="Wrap" />
                        <StackPanel x:Name="PaymentRows" Spacing="10" />
                        <Button HorizontalAlignment="Left" MinHeight="44" Click="OnAddPaymentMethod" Content="Adicionar método" />
                        <TextBlock x:Name="PaymentValidationText" Foreground="{StaticResource NofarmaDangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Border Padding="12" Background="#EEF3F9" CornerRadius="6">
                            <StackPanel Spacing="6">
                                <Grid><TextBlock Text="Total" /><TextBlock x:Name="PaymentTotalText" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                <Grid><TextBlock Text="Pago" /><TextBlock x:Name="PaymentPaidText" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                <Grid><TextBlock Text="Falta ou troco" /><TextBlock x:Name="PaymentBalanceText" HorizontalAlignment="Right" FontWeight="Bold" /></Grid>
                            </StackPanel>
                        </Border>
                        <Button x:Name="SubmitPaymentButton" MinHeight="52" Click="OnCompleteSale" Content="Concluir venda" Style="{StaticResource NofarmaPrimaryButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="SuspendPanel" Width="440" Padding="20" HorizontalAlignment="Right" VerticalAlignment="Center" Background="White" CornerRadius="8" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Suspender venda" />
                    <TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="O carrinho fica guardado neste computador. Não reserva stock nem altera o caixa." TextWrapping="Wrap" />
                    <TextBlock Text="Nome opcional" />
                    <TextBox x:Name="SuspendedNameBox" MinHeight="44" MaxLength="120" PlaceholderText="Ex.: Cliente balcão" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button MinHeight="44" Click="OnClosePanel" Content="Cancelar" />
                        <Button MinHeight="44" Click="OnSuspendSale" Content="Suspender venda" Style="{StaticResource NofarmaPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="SuspendedSalesPanel" Width="500" Padding="20" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="White" Visibility="Collapsed">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Vendas suspensas" />
                        <Button HorizontalAlignment="Right" MinWidth="44" MinHeight="44" Click="OnClosePanel" Content="Fechar" />
                    </Grid>
                    <ListView x:Name="SuspendedSalesList" Grid.Row="1" AutomationProperties.Name="Lista de vendas suspensas" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="sales:SuspendedSaleSummary">
                                <StackPanel Padding="8" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="{x:Bind LineCount}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button MinHeight="44" Click="OnDeleteSuspendedSale" Content="Eliminar" />
                        <Button MinHeight="44" Click="OnResumeSuspendedSale" Content="Retomar" Style="{StaticResource NofarmaPrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
