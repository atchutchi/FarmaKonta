<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nofarma.Desktop.Views.SuppliersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:supply="using:Nofarma.Application.Supply"
    Background="{StaticResource NofarmaCanvasBrush}"
    Loaded="OnLoaded">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource NofarmaHeadingStyle}" Text="Fornecedores" />
                <TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="Contactos e estado dos fornecedores locais." />
            </StackPanel>
            <Button HorizontalAlignment="Right" Click="OnShowEditor" Style="{StaticResource NofarmaPrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="16" Glyph="&#xE710;" /><TextBlock Text="Novo fornecedor" /></StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Padding="12" Background="White" BorderBrush="{StaticResource NofarmaBorderBrush}" BorderThickness="1" CornerRadius="8">
            <AutoSuggestBox x:Name="SupplierSearchBox" MinHeight="44" MaxWidth="640" HorizontalAlignment="Left" AutomationProperties.Name="Pesquisar fornecedores" PlaceholderText="Nome, telefone, email ou NIF" QueryIcon="Find" QuerySubmitted="OnSearchSubmitted" />
        </Border>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition x:Name="SupplierEditorColumn" Width="0" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource NofarmaBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ProgressRing x:Name="SuppliersProgress" Width="36" Height="36" Visibility="Collapsed" />
                    <StackPanel x:Name="SuppliersEmptyState" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                        <FontIcon HorizontalAlignment="Center" FontSize="32" Foreground="{StaticResource NofarmaBlueBrush}" Glyph="&#xE716;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Ainda não existem fornecedores registados" />
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource NofarmaMutedBrush}" Text="Regista o primeiro fornecedor para preparar compras e recepções de mercadoria." />
                    </StackPanel>
                    <ListView x:Name="SuppliersList" SelectionMode="None">
                        <ListView.Header>
                            <Grid MinHeight="44" Padding="14,0" Background="#EEF3F9" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Código" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Nome" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Contacto" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="Estado" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="supply:SupplierSummary">
                                <Grid MinHeight="48" Padding="14,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Id}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Phone}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource NofarmaGreenBrush}" Text="Activo" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border x:Name="SupplierEditor" Grid.Column="1" Padding="18" Background="White" BorderBrush="{StaticResource NofarmaBorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <Grid><TextBlock FontSize="20" FontWeight="SemiBold" Text="Novo fornecedor" /><Button HorizontalAlignment="Right" MinHeight="44" Click="OnHideEditor" Content="Fechar" /></Grid>
                        <InfoBar x:Name="SupplierMessage" IsClosable="True" IsOpen="False" />
                        <TextBlock Text="Nome do fornecedor *" /><TextBox x:Name="SupplierNameBox" MinHeight="44" />
                        <TextBlock Text="NIF" /><TextBox x:Name="SupplierTaxBox" MinHeight="44" />
                        <TextBlock Text="Telefone" /><TextBox x:Name="SupplierPhoneBox" MinHeight="44" />
                        <TextBlock Text="Email" /><TextBox x:Name="SupplierEmailBox" MinHeight="44" />
                        <TextBlock Text="Morada" /><TextBox x:Name="SupplierAddressBox" MinHeight="44" TextWrapping="Wrap" />
                        <TextBlock Text="Observações" /><TextBox x:Name="SupplierNotesBox" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock x:Name="SupplierValidationText" Foreground="#B42318" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Button x:Name="SaveSupplierButton" Margin="0,8,0,0" Click="OnSaveSupplier" Content="Guardar fornecedor" Style="{StaticResource NofarmaPrimaryButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
