<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nofarma.Desktop.Views.ModuleEmptyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource NofarmaCanvasBrush}">
    <Grid Padding="28">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="14">
            <TextBlock x:Name="TitleText" Style="{StaticResource NofarmaHeadingStyle}" />
            <Border
                Padding="22"
                Background="White"
                BorderBrush="{StaticResource NofarmaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Ainda sem registos" />
                    <TextBlock
                        x:Name="DescriptionText"
                        Foreground="{StaticResource NofarmaMutedBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{StaticResource NofarmaBlueDarkBrush}"
                        Text="A estrutura está preparada. Os dados aparecerão aqui quando este módulo for implementado e utilizado."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
