<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Nofarma.Desktop.Views.StockPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:inventory="using:Nofarma.Application.Inventory" Background="{StaticResource NofarmaCanvasBrush}" Loaded="OnLoaded">
    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><StackPanel Spacing="3"><TextBlock Style="{StaticResource NofarmaHeadingStyle}" Text="Stock por lote e validade" /><TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="Quantidades locais, lotes e prioridade de saída." /></StackPanel><Button HorizontalAlignment="Right" MinHeight="44" Click="OnRefresh" Content="Actualizar" /></Grid>
        <Border Grid.Row="1" Padding="12" Background="White" BorderBrush="{StaticResource NofarmaBorderBrush}" BorderThickness="1" CornerRadius="8"><AutoSuggestBox x:Name="StockSearchBox" MinHeight="44" MaxWidth="640" HorizontalAlignment="Left" AutomationProperties.Name="Pesquisar stock" PlaceholderText="Código, produto ou lote" QueryIcon="Find" QuerySubmitted="OnSearchSubmitted" /></Border>
        <InfoBar x:Name="StockAlertBar" Grid.Row="2" IsClosable="False" IsOpen="False" Severity="Warning" Title="Atenção ao stock" />
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource NofarmaBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ProgressRing x:Name="StockProgress" Width="36" Height="36" Visibility="Collapsed" />
                <StackPanel x:Name="StockEmptyState" MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed"><FontIcon HorizontalAlignment="Center" FontSize="32" Foreground="{StaticResource NofarmaBlueBrush}" Glyph="&#xE7B8;" /><TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Ainda não existem movimentos de stock" /><TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource NofarmaMutedBrush}" Text="Regista uma recepção, entrada rápida ou inventário inicial para começar a controlar quantidades e validades." /></StackPanel>
                <ListView x:Name="StockList" SelectionMode="None">
                    <ListView.Header><Grid MinHeight="44" Padding="14,0" Background="#EEF3F9" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="105" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Produto" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Lote" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Validade" /><TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="Disponível" /><TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="Unidade" /><TextBlock Grid.Column="5" VerticalAlignment="Center" FontWeight="SemiBold" Text="Fornecedor" /><TextBlock Grid.Column="6" VerticalAlignment="Center" FontWeight="SemiBold" Text="Estado" /></Grid></ListView.Header>
                    <ListView.ItemTemplate><DataTemplate x:DataType="inventory:StockOverviewItem"><Grid MinHeight="48" Padding="14,6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="105" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{x:Bind ProductName}" TextTrimming="CharacterEllipsis" /><TextBlock FontSize="12" Foreground="{StaticResource NofarmaMutedBrush}" Text="{x:Bind ProductCode}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind LotNumber}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind ExpiryDate}" /><TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind AvailableQuantityBase}" /><TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind BaseUnit}" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind SupplierName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{x:Bind ExpiryAlertLevel}" /></Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
