<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Nofarma.Desktop.Views.PurchasesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:purchasing="using:Nofarma.Application.Purchasing" Background="{StaticResource NofarmaCanvasBrush}" Loaded="OnLoaded">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="3"><TextBlock Style="{StaticResource NofarmaHeadingStyle}" Text="Compras e recepções" /><TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="Encomendas locais e entrada de mercadoria por lote." /></StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource NofarmaBorderBrush}" BorderThickness="1" CornerRadius="8"><Grid><StackPanel x:Name="PurchasesEmptyState" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed"><FontIcon HorizontalAlignment="Center" FontSize="32" Foreground="{StaticResource NofarmaBlueBrush}" Glyph="&#xE719;" /><TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Ainda não existem compras registadas" /><TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource NofarmaMutedBrush}" Text="Cria uma compra antes de receber mercadoria e actualizar o stock." /></StackPanel><ListView x:Name="PurchasesList" SelectionChanged="OnPurchaseSelected" SelectionMode="Single"><ListView.Header><Grid MinHeight="44" Padding="14,0" Background="#EEF3F9" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /><ColumnDefinition Width="100" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Fornecedor" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Documento" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Data" /><TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="Estado" /><TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="Linhas" /></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate x:DataType="purchasing:PurchaseSummary"><Grid MinHeight="50" Padding="14,6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /><ColumnDefinition Width="100" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind SupplierName}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind DocumentNumber}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind DocumentDate}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Status}" /><TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind LineCount}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
            <Border Grid.Column="1" Padding="18" Background="White" BorderBrush="{StaticResource NofarmaBorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer><StackPanel Spacing="8"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Receber compra" /><TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="Selecciona uma compra e confirma cada linha recebida." TextWrapping="Wrap" /><InfoBar x:Name="PurchaseMessage" IsClosable="True" IsOpen="False" /><TextBlock Text="Produto *" /><ComboBox x:Name="PurchaseLineBox" MinHeight="44" DisplayMemberPath="ProductName" SelectionChanged="OnReceiptFieldChanged" /><TextBlock Text="Documento de recepção *" /><TextBox x:Name="ReceiptDocumentBox" MinHeight="44" TextChanged="OnReceiptFieldChanged" /><TextBlock Text="Lote *" /><TextBox x:Name="ReceiptLotBox" MinHeight="44" TextChanged="OnReceiptFieldChanged" /><TextBlock Text="Validade *" /><CalendarDatePicker x:Name="ReceiptExpiryPicker" MinHeight="44" DateChanged="OnReceiptDateChanged" /><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="Quantidade *" /><TextBox x:Name="ReceiptQuantityBox" MinHeight="44" InputScope="Number" TextChanged="OnReceiptFieldChanged" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Custo unitário (XOF) *" /><TextBox x:Name="ReceiptCostBox" MinHeight="44" InputScope="Number" TextChanged="OnReceiptFieldChanged" /></StackPanel></Grid><TextBlock x:Name="ReceiptValidationText" Foreground="#B42318" TextWrapping="Wrap" Visibility="Collapsed" /><Button x:Name="ConfirmReceiptButton" Margin="0,8,0,0" IsEnabled="False" Click="OnConfirmReceipt" Content="Receber mercadoria" Style="{StaticResource NofarmaPrimaryButtonStyle}" /></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</Page>
