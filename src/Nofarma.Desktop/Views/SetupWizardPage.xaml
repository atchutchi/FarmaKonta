<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nofarma.Desktop.Views.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource NofarmaCanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource NofarmaBlueBrush}">
            <TextBlock
                Margin="20,0"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Text"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Text="NôFarma by ABIPTOM" />
            <TextBlock
                x:Name="QaModeText"
                Margin="20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="#FFE082"
                Text="Modo QA"
                Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                Padding="30,28"
                Background="White"
                BorderBrush="{StaticResource NofarmaBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{StaticResource NofarmaBlueDarkBrush}"
                        Text="NôFarma" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource NofarmaBlueBrush}"
                        Text="by ABIPTOM" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,28,0,0"
                    Spacing="18">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StepOneCircle" Fill="{StaticResource NofarmaBlueBrush}" />
                        <TextBlock
                            x:Name="StepOneNumber"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="1" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Configurar farmácia" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StepTwoCircle" Stroke="{StaticResource NofarmaBorderBrush}" StrokeThickness="1" />
                        <TextBlock
                            x:Name="StepTwoNumber"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="2" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Criar administrador" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StepThreeCircle" Stroke="{StaticResource NofarmaBorderBrush}" StrokeThickness="1" />
                        <TextBlock
                            x:Name="StepThreeNumber"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="3" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Código de recuperação" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StepFourCircle" Stroke="{StaticResource NofarmaBorderBrush}" StrokeThickness="1" />
                        <TextBlock
                            x:Name="StepFourNumber"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="4" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Concluir preparação" />
                    </Grid>
                </StackPanel>

                <Border
                    Grid.Row="3"
                    Padding="16"
                    Background="#EEF6FF"
                    BorderBrush="#ADD3FF"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{StaticResource NofarmaBlueDarkBrush}"
                            Text="Preparação offline" />
                        <TextBlock
                            Foreground="{StaticResource NofarmaMutedBrush}"
                            Text="Tudo funciona neste computador. Não é necessária internet para preparar a farmácia."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Padding="44,30,44,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="Revê os dados indicados" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="PharmacyPanel" MaxWidth="720" HorizontalAlignment="Left" Spacing="12">
                            <TextBlock Style="{StaticResource NofarmaHeadingStyle}" Text="Configurar farmácia" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{StaticResource NofarmaMutedBrush}"
                                Text="Regista os dados do estabelecimento. Poderás alterá-los mais tarde nas configurações."
                                TextWrapping="Wrap" />
                            <TextBlock Text="Nome da farmácia *" />
                            <TextBox Style="{StaticResource NofarmaFieldStyle}" Text="{x:Bind ViewModel.PharmacyName, Mode=TwoWay}" />
                            <TextBlock Text="NIF da farmácia *" />
                            <TextBox Style="{StaticResource NofarmaFieldStyle}" Text="{x:Bind ViewModel.TaxIdentifier, Mode=TwoWay}" />
                            <TextBlock Text="Endereço *" />
                            <TextBox Style="{StaticResource NofarmaFieldStyle}" Text="{x:Bind ViewModel.Address, Mode=TwoWay}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Telefone ou contacto" />
                                    <TextBox Style="{StaticResource NofarmaFieldStyle}" Text="{x:Bind ViewModel.Contact, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Fuso horário" />
                                    <TextBox IsReadOnly="True" Style="{StaticResource NofarmaFieldStyle}" Text="{x:Bind ViewModel.TimeZoneId}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Nome deste computador *" />
                            <TextBox Style="{StaticResource NofarmaFieldStyle}" Text="{x:Bind ViewModel.DeviceName, Mode=TwoWay}" />
                            <TextBlock Foreground="{StaticResource NofarmaMutedBrush}" Text="* Campo obrigatório" />
                        </StackPanel>

                        <StackPanel
                            x:Name="AdministratorPanel"
                            MaxWidth="720"
                            HorizontalAlignment="Left"
                            Spacing="12"
                            Visibility="Collapsed">
                            <TextBlock Style="{StaticResource NofarmaHeadingStyle}" Text="Criar administrador" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{StaticResource NofarmaMutedBrush}"
                                Text="Este utilizador terá acesso às definições e às operações sensíveis."
                                TextWrapping="Wrap" />
                            <TextBlock Text="Nome completo *" />
                            <TextBox Style="{StaticResource NofarmaFieldStyle}" Text="{x:Bind ViewModel.AdministratorName, Mode=TwoWay}" />
                            <TextBlock Text="Nome de utilizador *" />
                            <TextBox Style="{StaticResource NofarmaFieldStyle}" Text="{x:Bind ViewModel.AdministratorLogin, Mode=TwoWay}" />
                            <TextBlock Text="Palavra-passe *" />
                            <PasswordBox x:Name="AdministratorPasswordBox" MinHeight="40" CornerRadius="5" PasswordRevealMode="Peek" />
                            <TextBlock Text="Confirmar palavra-passe *" />
                            <PasswordBox x:Name="PasswordConfirmationBox" MinHeight="40" CornerRadius="5" PasswordRevealMode="Peek" />
                            <Border
                                Margin="0,8,0,0"
                                Padding="14"
                                Background="#EEF8F2"
                                BorderBrush="#A9D8BA"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    Foreground="#176B37"
                                    Text="Usa pelo menos 12 caracteres com maiúscula, minúscula, número e símbolo."
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <StackPanel
                            x:Name="RecoveryPanel"
                            MaxWidth="720"
                            HorizontalAlignment="Left"
                            Spacing="16"
                            Visibility="Collapsed">
                            <TextBlock Style="{StaticResource NofarmaHeadingStyle}" Text="Código de recuperação" />
                            <TextBlock
                                Foreground="{StaticResource NofarmaMutedBrush}"
                                Text="Este código permite recuperar o acesso sem internet. Guarda-o fora deste computador."
                                TextWrapping="Wrap" />
                            <Border
                                Padding="28"
                                Background="White"
                                BorderBrush="{StaticResource NofarmaBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" Spacing="14">
                                    <TextBlock HorizontalAlignment="Center" Text="O teu código de recuperação único" />
                                    <TextBlock
                                        x:Name="RecoveryCodeText"
                                        FontFamily="Cascadia Mono"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource NofarmaBlueDarkBrush}" />
                                    <Button HorizontalAlignment="Center" Click="OnCopyRecoveryCode" Content="Copiar código" />
                                </StackPanel>
                            </Border>
                            <Border
                                Padding="16"
                                Background="#FFF8E8"
                                BorderBrush="#F2C65C"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="Guarda este código num local seguro" />
                                    <TextBlock Text="Sem este código poderás perder o acesso se esqueceres a palavra-passe." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <CheckBox
                                x:Name="RecoverySavedCheckBox"
                                Content="Confirmo que guardei o código fora deste computador"
                                Checked="OnRecoveryConfirmationChanged"
                                Unchecked="OnRecoveryConfirmationChanged" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BackButton"
                        Grid.Column="1"
                        MinWidth="112"
                        MinHeight="44"
                        Margin="0,0,12,0"
                        Click="OnBack"
                        Content="Voltar"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="ContinueButton"
                        Grid.Column="2"
                        MinWidth="144"
                        Click="OnContinue"
                        Content="Continuar"
                        Style="{StaticResource NofarmaPrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
