<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nofarma.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource NofarmaCanvasBrush}"
    Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource NofarmaBlueBrush}">
            <TextBlock
                Margin="20,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="White"
                Text="NôFarma by ABIPTOM" />
            <TextBlock
                x:Name="QaModeText"
                Margin="20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="#FFE082"
                Text="Modo QA"
                Visibility="Collapsed" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="900"
                Margin="32"
                HorizontalAlignment="Center"
                Spacing="18">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource NofarmaHeadingStyle}"
                    Text="Iniciar sessão" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource NofarmaMutedBrush}"
                    Text="Escolhe o tipo de acesso para continuar." />
                <InfoBar
                    x:Name="LoginErrorBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error" />
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="24"
                        Background="White"
                        BorderBrush="{StaticResource NofarmaBlueBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NofarmaBlueDarkBrush}"
                                Text="Administrador" />
                            <TextBlock
                                Foreground="{StaticResource NofarmaMutedBrush}"
                                Text="Acesso às definições e operações autorizadas."
                                TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Text="Utilizador" />
                            <ComboBox
                                x:Name="AdministratorProfileBox"
                                MinHeight="40"
                                DisplayMemberPath="DisplayName" />
                            <TextBlock Text="Palavra-passe" />
                            <PasswordBox
                                x:Name="AdministratorCredentialBox"
                                MinHeight="40"
                                PasswordRevealMode="Peek" />
                            <Button
                                Margin="0,12,0,0"
                                Click="OnAdministratorSignIn"
                                Content="Iniciar sessão como administrador"
                                Style="{StaticResource NofarmaPrimaryButtonStyle}" />
                            <Button
                                MinHeight="44"
                                Click="OnRecoverAccess"
                                Content="Recuperar acesso" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="24"
                        Background="#F5FBF7"
                        BorderBrush="{StaticResource NofarmaGreenBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="#176B37"
                                Text="Caixa" />
                            <TextBlock
                                Foreground="{StaticResource NofarmaMutedBrush}"
                                Text="Acesso rápido para vendas e operações diárias."
                                TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Text="Perfil do Caixa" />
                            <ComboBox
                                x:Name="CashierProfileBox"
                                MinHeight="40"
                                DisplayMemberPath="DisplayName" />
                            <TextBlock Text="PIN" />
                            <PasswordBox
                                x:Name="CashierCredentialBox"
                                MaxLength="6"
                                MinHeight="40"
                                PasswordRevealMode="Hidden" />
                            <Grid RowSpacing="6" ColumnSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Tag="1" Click="OnPinKey" Content="1" />
                                <Button Grid.Row="0" Grid.Column="1" Tag="2" Click="OnPinKey" Content="2" />
                                <Button Grid.Row="0" Grid.Column="2" Tag="3" Click="OnPinKey" Content="3" />
                                <Button Grid.Row="1" Grid.Column="0" Tag="4" Click="OnPinKey" Content="4" />
                                <Button Grid.Row="1" Grid.Column="1" Tag="5" Click="OnPinKey" Content="5" />
                                <Button Grid.Row="1" Grid.Column="2" Tag="6" Click="OnPinKey" Content="6" />
                                <Button Grid.Row="2" Grid.Column="0" Tag="7" Click="OnPinKey" Content="7" />
                                <Button Grid.Row="2" Grid.Column="1" Tag="8" Click="OnPinKey" Content="8" />
                                <Button Grid.Row="2" Grid.Column="2" Tag="9" Click="OnPinKey" Content="9" />
                                <Button Grid.Row="3" Grid.Column="0" Click="OnPinBackspace" Content="⌫" />
                                <Button Grid.Row="3" Grid.Column="1" Tag="0" Click="OnPinKey" Content="0" />
                                <Button Grid.Row="3" Grid.Column="2" Click="OnPinClear" Content="Limpar" />
                            </Grid>
                            <Button
                                Margin="0,6,0,0"
                                Background="{StaticResource NofarmaGreenBrush}"
                                Click="OnCashierSignIn"
                                Content="Iniciar sessão como Caixa"
                                Foreground="White"
                                MinHeight="44" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="2"
            Padding="18,0"
            Background="White"
            BorderBrush="{StaticResource NofarmaBorderBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="#176B37" Text="●  Modo offline" />
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource NofarmaBlueDarkBrush}" Text="NôFarma by ABIPTOM" />
        </Grid>
    </Grid>
</Page>
